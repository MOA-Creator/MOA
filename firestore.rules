rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------
    // CHANGE THIS: the Google emails of everyone who may open the dev page.
    // This list is the ONLY place devs are defined.
    // ------------------------------------------------------------------
    function isDev() {
      return request.auth != null
          && request.auth.token.email_verified == true
          && request.auth.token.email in ['YOUR_EMAIL@gmail.com'];
    }

    // Visitors may only ever ADD 1 to these counters - nothing else.
    function validKeys() {
      return request.resource.data.keys().hasOnly(['views', 'uniques', 'searchVisits', 'downloads']);
    }
    function firstBump(f) {
      return !(f in request.resource.data) || request.resource.data[f] == 1;
    }
    function bumped(f) {
      return !(f in request.resource.data)
          || (f in resource.data
              ? request.resource.data[f] in [resource.data[f], resource.data[f] + 1]
              : request.resource.data[f] == 1);
    }
    function counterCreate() {
      return validKeys() && firstBump('views') && firstBump('uniques')
          && firstBump('searchVisits') && firstBump('downloads');
    }
    function counterUpdate() {
      return validKeys() && bumped('views') && bumped('uniques')
          && bumped('searchVisits') && bumped('downloads');
    }

    match /stats/{docId} {
      allow read: if isDev();
      allow create: if docId == 'totals' && counterCreate();
      allow update: if docId == 'totals' && counterUpdate();
    }

    match /daily/{day} {
      allow read: if isDev();
      allow create: if day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && counterCreate();
      allow update: if day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && counterUpdate();
    }
  }
}
